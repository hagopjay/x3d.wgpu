<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE X3D PUBLIC "ISO//Web3D//DTD X3D 4.1//EN" "https://www.web3d.org/specifications/x3d-4.1.dtd">
<X3D profile='Full' version='4.1' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.1.xsd'>
  <head>
    <meta name='title' content='09_environment.x3d'/>
    <meta name='description' content='EnvironmentLight (image-based lighting): top row gold metal, bottom row red plastic, roughness 0 to 1 left to right. Lit only by a generated sky cube (sky/*.png).'/>
  </head>
  <Scene>
    <NavigationInfo headlight='false'/>
    <Background skyColor='0.55 0.65 0.8'/>
    <Viewpoint position='0 0 5' description='Material sweep'/>
    <EnvironmentLight intensity='1'>
      <ComposedCubeMapTexture containerField='specularTexture'>
          <ImageTexture containerField='frontTexture' url='"sky/front.png"'/>
          <ImageTexture containerField='backTexture' url='"sky/back.png"'/>
          <ImageTexture containerField='leftTexture' url='"sky/left.png"'/>
          <ImageTexture containerField='rightTexture' url='"sky/right.png"'/>
          <ImageTexture containerField='topTexture' url='"sky/top.png"'/>
          <ImageTexture containerField='bottomTexture' url='"sky/bottom.png"'/>
      </ComposedCubeMapTexture>
    </EnvironmentLight>
    <Transform translation='-2.6 0.7 0'>
      <Shape><Appearance><PhysicalMaterial baseColor='1 0.78 0.34' metallic='1' roughness='0.0'/></Appearance><Sphere radius='0.55'/></Shape>
    </Transform>
    <Transform translation='-1.3 0.7 0'>
      <Shape><Appearance><PhysicalMaterial baseColor='1 0.78 0.34' metallic='1' roughness='0.25'/></Appearance><Sphere radius='0.55'/></Shape>
    </Transform>
    <Transform translation='0.0 0.7 0'>
      <Shape><Appearance><PhysicalMaterial baseColor='1 0.78 0.34' metallic='1' roughness='0.5'/></Appearance><Sphere radius='0.55'/></Shape>
    </Transform>
    <Transform translation='1.3 0.7 0'>
      <Shape><Appearance><PhysicalMaterial baseColor='1 0.78 0.34' metallic='1' roughness='0.75'/></Appearance><Sphere radius='0.55'/></Shape>
    </Transform>
    <Transform translation='2.6 0.7 0'>
      <Shape><Appearance><PhysicalMaterial baseColor='1 0.78 0.34' metallic='1' roughness='1.0'/></Appearance><Sphere radius='0.55'/></Shape>
    </Transform>
    <Transform translation='-2.6 -0.7 0'>
      <Shape><Appearance><PhysicalMaterial baseColor='0.8 0.1 0.1' metallic='0' roughness='0.0'/></Appearance><Sphere radius='0.55'/></Shape>
    </Transform>
    <Transform translation='-1.3 -0.7 0'>
      <Shape><Appearance><PhysicalMaterial baseColor='0.8 0.1 0.1' metallic='0' roughness='0.25'/></Appearance><Sphere radius='0.55'/></Shape>
    </Transform>
    <Transform translation='0.0 -0.7 0'>
      <Shape><Appearance><PhysicalMaterial baseColor='0.8 0.1 0.1' metallic='0' roughness='0.5'/></Appearance><Sphere radius='0.55'/></Shape>
    </Transform>
    <Transform translation='1.3 -0.7 0'>
      <Shape><Appearance><PhysicalMaterial baseColor='0.8 0.1 0.1' metallic='0' roughness='0.75'/></Appearance><Sphere radius='0.55'/></Shape>
    </Transform>
    <Transform translation='2.6 -0.7 0'>
      <Shape><Appearance><PhysicalMaterial baseColor='0.8 0.1 0.1' metallic='0' roughness='1.0'/></Appearance><Sphere radius='0.55'/></Shape>
    </Transform>
  </Scene>
</X3D>
